<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>com.apple.security.application-groups</key>
  <array><string>group.in.jhselfdrive.ops</string></array>
  <key>keychain-access-groups</key>
  <!-- Team-prefixed so it matches the profile's <TeamID>.* wildcard; a bare
       app-group name is rejected at codesign with "doesn't match the
       entitlements file's value for the keychain-access-groups entitlement". -->
  <array><string>$(AppIdentifierPrefix)group.in.jhselfdrive.ops</string></array>
</dict>
</plist>
