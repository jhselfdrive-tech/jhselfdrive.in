# Supabase project settings (server-side only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public analytics ID. Leave blank to disable GA4 outside production.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# GA4 reporting (server-side only) for the admin Traffic page.
# GA4_PROPERTY_ID is the numeric property ID, not the G-XXXXXXXXXX measurement ID above.
GA4_PROPERTY_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# Used to hash IP addresses for rate limiting. Generate a long random value.
RATE_LIMIT_SALT=replace-with-at-least-32-random-characters

# Canonical URL used by metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://jhselfdrive.in

# The share URL for the verified Google Business Profile. The search URL fallback
# works without this, but the listing's exact share URL is better for local SEO.
NEXT_PUBLIC_GOOGLE_MAPS_URL=

# Google Search Console verification token (the content value of the HTML tag method).
# Optional — leave blank to omit the meta tag. DNS TXT verification is more durable
# because it survives redeploys and does not depend on this variable being set.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# JH Ops iOS app — Apple Push Notification service.
# From the Apple Developer portal: Keys → create an APNs Auth Key (.p8).
# APNS_KEY_P8 holds the whole PEM; Vercel cannot store real newlines, so
# escaped \n is accepted too. Each device’s registered environment selects the
# APNs host; APNS_ENVIRONMENT is only the default for callers omitting it.
# ---------------------------------------------------------------------------
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=in.jhselfdrive.ops
APNS_ENVIRONMENT=production

# Shared secret for POST /api/ops/cron, called by Supabase pg_cron.
# Generate with: openssl rand -hex 32
OPS_CRON_SECRET=

# Minimum supported iOS build returned by the admin-only /api/ops/meta endpoint.
OPS_MIN_APP_BUILD=1
