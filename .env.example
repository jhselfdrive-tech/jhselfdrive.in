# Supabase project settings (server-side only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public analytics ID. Leave blank to disable GA4 outside production.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# GA4 reporting (server-side only) for the admin Traffic page.
# GA4_PROPERTY_ID is the numeric property ID, not the G-XXXXXXXXXX measurement ID above.
GA4_PROPERTY_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# Used to hash IP addresses for rate limiting. Generate a long random value.
RATE_LIMIT_SALT=replace-with-at-least-32-random-characters

# Canonical URL used by metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://jhselfdrive.in

# Google Search Console verification token (the content value of the HTML tag method).
# Optional — leave blank to omit the meta tag. DNS TXT verification is more durable
# because it survives redeploys and does not depend on this variable being set.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
